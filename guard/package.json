{
  "name": "pipaya-extension-guard",
  "version": "0.2.3",
  "description": "Blocks destructive shell commands (wiping / or ~, formatting or overwriting a disk, fork bombs) before they run.",
  "license": "MIT",
  "author": "dohwi",
  "pipaya": {
    "title": "Guard",
    "descriptions": {
      "en": "Stops a bash command before it runs when it would wipe / or ~, format or overwrite a disk, fork-bomb the machine or change the permissions of the whole disk. Each family can be switched off below.",
      "ko": "bash 명령이 /·~ 전체 삭제, 디스크 포맷·덮어쓰기, 포크 폭탄, 디스크 전체 권한 변경을 하려 하면 실행 전에 막습니다. 항목별로 아래에서 끌 수 있습니다."
    },
    "settings": [
      {
        "key": "wipe",
        "type": "boolean",
        "label": "Wipe disk / home",
        "description": "rm -rf /, rm -rf ~",
        "default": true
      },
      {
        "key": "disk",
        "type": "boolean",
        "label": "Format / overwrite disk",
        "description": "mkfs, dd of=/dev/sdX, > /dev/nvme0n1",
        "default": true
      },
      {
        "key": "fork",
        "type": "boolean",
        "label": "Fork bombs",
        "description": ":(){ :|:& };:",
        "default": true
      },
      {
        "key": "permissions",
        "type": "boolean",
        "label": "Disk / home permissions",
        "description": "chmod -R / chown -R on / or ~",
        "default": true
      }
    ],
    "translations": {
      "ko": {
        "Wipe disk / home": "디스크·홈 삭제 차단",
        "Format / overwrite disk": "디스크 포맷·덮어쓰기 차단",
        "Fork bombs": "포크 폭탄 차단",
        "Disk / home permissions": "디스크·홈 권한 변경 차단",
        "chmod -R / chown -R on / or ~": "/·~ 전체 chmod -R · chown -R"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dohwi/pipaya-extensions.git",
    "directory": "guard"
  },
  "type": "module",
  "scripts": {
    "test": "bun test"
  }
}
