{
  "manifest": {
    "id": "voice-input",
    "name": "Voice Input",
    "version": "0.1.0",
    "sdkVersion": 1,
    "description": "입력창에 마이크 버튼을 추가합니다. 말한 내용을 CLIProxyAPI의 Mistral Voxtral로 받아써서 입력창에 넣습니다. / Adds a microphone button to the composer and transcribes speech with Mistral Voxtral.",
    "permissions": [
      "ui-components"
    ],
    "settings": [
      {
        "key": "apiBase",
        "type": "string",
        "label": "CLIProxyAPI 주소 (API base)",
        "description": "mistral-support 플러그인이 있는 CLIProxyAPI의 origin입니다. 경로나 계정 정보는 넣지 마세요. 마이크는 HTTPS 화면에서만 켜지므로 https 주소를 권장합니다. / Origin of your CLIProxyAPI that has the mistral-support plugin.",
        "placeholder": "https://your-cliproxyapi.example.com",
        "required": true,
        "format": "origin"
      },
      {
        "key": "apiKey",
        "type": "string",
        "label": "관리 키 (Management Key)",
        "description": "CLIProxyAPI 관리 키입니다. 이 기기에만 평문으로 저장되고 내보내기에서는 제외됩니다. 비어 있으면 마이크 버튼이 설정을 안내합니다. / Stored in plain text on this device only.",
        "secret": true,
        "required": true
      },
      {
        "key": "model",
        "type": "string",
        "label": "모델 (Model)",
        "description": "받아쓰기 모델입니다. 비우면 서버 기본값을 씁니다.",
        "default": "voxtral-mini-transcribe-3-0",
        "placeholder": "voxtral-mini-transcribe-3-0"
      },
      {
        "key": "language",
        "type": "string",
        "label": "말하는 언어 (Language)",
        "description": "ISO 639-1 코드입니다(예: ko, en, ja). 비우면 자동으로 감지합니다.",
        "default": "ko",
        "placeholder": "ko"
      }
    ],
    "settingsScope": "local"
  },
  "components": {
    "VoiceButton": "<script module>\n\t// Pure helpers for VoiceButton.svelte. scripts/build.mjs inlines this file into the component's <script module>\n// (a trusted component can import only `pipaya`, `svelte*` and sibling .svelte files), and the tests import it directly.\n// Keep it free of DOM, network and storage access.\n\nconst MAX_RECORD_MS = 5 * 60 * 1000;\nconst MIN_RECORD_MS = 400;\nconst MIN_BLOB_BYTES = 800;\nconst UPLOAD_TIMEOUT_MS = 60 * 1000;\n\n// Preference order. Chrome/Firefox/Edge make webm or ogg (opus), Safari makes mp4. Voxtral accepts them all\n// (checked by uploading m4a, webm/opus and wav), so the browser's own format is uploaded as is.\nconst MIME_CANDIDATES = ['audio/webm;codecs=opus', 'audio/webm', 'audio/mp4', 'audio/ogg;codecs=opus', 'audio/ogg'];\n\nfunction pickMimeType(isSupported) {\n  for (const type of MIME_CANDIDATES) {\n    try { if (isSupported(type)) return type; } catch { /* try the next one */ }\n  }\n  return '';\n}\n\nfunction baseMime(type) {\n  return String(type || '').split(';')[0].trim().toLowerCase();\n}\n\nfunction extensionFor(type) {\n  switch (baseMime(type)) {\n    case 'audio/webm': return 'webm';\n    case 'audio/mp4': case 'audio/x-m4a': case 'audio/aac': return 'm4a';\n    case 'audio/ogg': return 'ogg';\n    case 'audio/wav': case 'audio/x-wav': case 'audio/wave': return 'wav';\n    case 'audio/mpeg': return 'mp3';\n    default: return 'webm';\n  }\n}\n\nfunction formatTime(ms) {\n  const total = Math.max(0, Math.floor(ms / 1000));\n  return `${Math.floor(total / 60)}:${String(total % 60).padStart(2, '0')}`;\n}\n\n// Append to what is already typed, separated by one space; never replace the draft.\nfunction joinDraft(current, addition) {\n  const add = String(addition ?? '').trim();\n  const cur = String(current ?? '');\n  if (!add) return cur;\n  return cur.trim() ? `${cur.replace(/\\s+$/, '')} ${add}` : add;\n}\n\n// There is no default address: the user enters their own. Returns the bare http(s) origin, or '' when the\n// setting is empty or not an origin (no path, query, credentials), so nothing is ever sent to a guessed place.\nfunction originOf(apiBase) {\n  const text = String(apiBase ?? '').trim();\n  if (!text) return '';\n  let url;\n  try { url = new URL(text); } catch { return ''; }\n  if (url.protocol !== 'https:' && url.protocol !== 'http:') return '';\n  if (url.username || url.password || url.search || url.hash || !/^\\/*$/.test(url.pathname)) return '';\n  return url.origin;\n}\n\nfunction endpoint(apiBase) {\n  return `${originOf(apiBase)}/v0/management/audio/transcriptions`;\n}\n\nfunction hostOf(apiBase) {\n  try { return new URL(String(apiBase)).host; } catch { return String(apiBase ?? ''); }\n}\n\n// context_bias is deliberately never sent: the server adds its stored term list.\nfunction buildForm(blob, { model, language }) {\n  const form = new FormData();\n  const type = baseMime(blob.type) || 'audio/webm';\n  form.append('file', new File([blob], `voice.${extensionFor(type)}`, { type }));\n  const m = String(model ?? '').trim();\n  if (m) form.append('model', m);\n  const l = String(language ?? '').trim();\n  if (l) form.append('language', l);\n  return form;\n}\n\nclass VoiceError extends Error {\n  constructor(kind, status) {\n    super(kind);\n    this.kind = kind;\n    this.status = status;\n  }\n}\n\n// One upload. The key goes only into the Authorization header and never into a message or log.\n// Throws VoiceError(kind) with kind in needBase | aborted | timeout | network | badKey | rateLimited | tooBig | serverError | badResponse | empty.\nasync function transcribe({ fetchImpl, apiBase, apiKey, model, language, blob, timeoutMs = UPLOAD_TIMEOUT_MS, signal }) {\n  if (!originOf(apiBase)) throw new VoiceError('needBase');\n  const control = new AbortController();\n  let timedOut = false;\n  const timer = setTimeout(() => { timedOut = true; control.abort(); }, timeoutMs);\n  const onAbort = () => control.abort();\n  if (signal) { if (signal.aborted) control.abort(); else signal.addEventListener('abort', onAbort, { once: true }); }\n  try {\n    let response;\n    try {\n      response = await fetchImpl(endpoint(apiBase), {\n        method: 'POST',\n        headers: { Authorization: `Bearer ${apiKey}` },\n        body: buildForm(blob, { model, language }),\n        credentials: 'omit',\n        referrerPolicy: 'no-referrer',\n        redirect: 'error',\n        signal: control.signal\n      });\n    } catch {\n      throw new VoiceError(timedOut ? 'timeout' : control.signal.aborted ? 'aborted' : 'network');\n    }\n    if (!response.ok) throw new VoiceError(httpErrorKind(response.status), response.status);\n    let body;\n    try { body = await response.json(); } catch { throw new VoiceError(timedOut ? 'timeout' : control.signal.aborted ? 'aborted' : 'badResponse'); }\n    if (typeof body?.text !== 'string') throw new VoiceError('badResponse');\n    const text = body.text.trim();\n    if (!text) throw new VoiceError('empty');\n    return text;\n  } finally {\n    clearTimeout(timer);\n    signal?.removeEventListener('abort', onAbort);\n  }\n}\n\nfunction micErrorKind(error) {\n  switch (error?.name) {\n    case 'NotAllowedError': case 'PermissionDeniedError': case 'SecurityError': return 'micDenied';\n    case 'NotFoundError': case 'DevicesNotFoundError': case 'OverconstrainedError': return 'noMic';\n    case 'NotReadableError': case 'TrackStartError': case 'AbortError': return 'micBusy';\n    default: return 'micFailed';\n  }\n}\n\nfunction httpErrorKind(status) {\n  if (status === 401 || status === 403) return 'badKey';\n  if (status === 429) return 'rateLimited';\n  if (status === 413) return 'tooBig';\n  return 'serverError';\n}\n\nconst STRINGS = {\n  ko: {\n    idle: '음성으로 입력',\n    recording: '녹음 중 — 눌러서 정지하고 변환',\n    transcribing: '변환 중…',\n    transcribingShort: '변환 중',\n    cancel: '녹음 취소',\n    errorShort: '오류',\n    needBase: '설정에서 CLIProxyAPI 주소를 입력하세요(예: https://서버 주소).',\n    needBaseShort: '주소 필요',\n    needKey: 'CLIProxyAPI 관리 키가 없습니다. 확장 설정에서 키를 입력하세요.',\n    needKeyShort: '키 필요',\n    badKey: '관리 키가 거부되었습니다({status}). 설정에서 키를 고치세요. 서버의 IP 차단을 피하려고 키를 바꿀 때까지 요청하지 않습니다.',\n    badKeyShort: '키 거부됨',\n    micDenied: '마이크 권한이 거부되었습니다. 주소창의 사이트 설정에서 마이크를 허용한 뒤 다시 누르세요.',\n    micDeniedShort: '마이크 거부됨',\n    noMic: '마이크를 찾을 수 없습니다. 장치 연결을 확인하세요.',\n    noMicShort: '마이크 없음',\n    micBusy: '마이크를 열 수 없습니다. 다른 앱이 쓰고 있을 수 있습니다.',\n    micBusyShort: '마이크 사용 불가',\n    micFailed: '마이크를 시작하지 못했습니다.',\n    micFailedShort: '마이크 오류',\n    insecure: '마이크는 HTTPS 주소에서만 켤 수 있습니다. https:// 로 접속하세요.',\n    insecureShort: 'HTTPS 필요',\n    unsupported: '이 브라우저는 녹음을 지원하지 않습니다.',\n    unsupportedShort: '녹음 미지원',\n    network: '{host}에 연결할 수 없습니다. 네트워크와 확장 설정의 서버 주소를 확인하세요.',\n    networkShort: '연결 실패',\n    timeout: '변환 요청이 {sec}초 안에 끝나지 않았습니다.',\n    timeoutShort: '시간 초과',\n    rateLimited: '요청이 너무 많습니다(429). 잠시 후 다시 시도하세요.',\n    rateLimitedShort: '요청 과다',\n    tooBig: '녹음이 너무 깁니다(413). 더 짧게 나눠 말해 주세요.',\n    tooBigShort: '너무 김',\n    serverError: '변환 서버 오류({status}).',\n    serverErrorShort: '서버 오류',\n    tooShort: '녹음이 너무 짧습니다.',\n    tooShortShort: '너무 짧음',\n    empty: '인식된 내용이 없습니다. 다시 말해 보세요.',\n    emptyShort: '인식 없음',\n    badResponse: '변환 서버의 응답을 읽을 수 없습니다.',\n    badResponseShort: '응답 오류',\n    paneChanged: '입력창이 바뀌어 넣지 않았습니다. 변환 결과: {text}',\n    paneChangedShort: '입력창 변경됨'\n  },\n  en: {\n    idle: 'Dictate',\n    recording: 'Recording — click to stop and transcribe',\n    transcribing: 'Transcribing…',\n    transcribingShort: 'Working',\n    cancel: 'Cancel recording',\n    errorShort: 'Error',\n    needBase: 'Enter the CLIProxyAPI address in the extension settings (for example https://your-server).',\n    needBaseShort: 'Address needed',\n    needKey: 'The CLIProxyAPI management key is not set. Enter it in the extension settings.',\n    needKeyShort: 'Key needed',\n    badKey: 'The management key was rejected ({status}). Fix it in the settings. Requests stop until the key changes, to avoid a server IP ban.',\n    badKeyShort: 'Key rejected',\n    micDenied: 'Microphone permission was denied. Allow the microphone in the site settings next to the address bar, then try again.',\n    micDeniedShort: 'Mic denied',\n    noMic: 'No microphone found. Check that a device is connected.',\n    noMicShort: 'No mic',\n    micBusy: 'The microphone cannot be opened. Another app may be using it.',\n    micBusyShort: 'Mic unavailable',\n    micFailed: 'Could not start the microphone.',\n    micFailedShort: 'Mic error',\n    insecure: 'The microphone works only on an HTTPS address. Open pipaya with https://.',\n    insecureShort: 'HTTPS needed',\n    unsupported: 'This browser cannot record audio.',\n    unsupportedShort: 'Unsupported',\n    network: 'Cannot reach {host}. Check the network and the server address in the extension settings.',\n    networkShort: 'Unreachable',\n    timeout: 'Transcription did not finish within {sec} seconds.',\n    timeoutShort: 'Timed out',\n    rateLimited: 'Too many requests (429). Try again in a moment.',\n    rateLimitedShort: 'Rate limited',\n    tooBig: 'The recording is too long (413). Speak in shorter parts.',\n    tooBigShort: 'Too long',\n    serverError: 'Transcription server error ({status}).',\n    serverErrorShort: 'Server error',\n    tooShort: 'The recording is too short.',\n    tooShortShort: 'Too short',\n    empty: 'Nothing was recognised. Try again.',\n    emptyShort: 'Nothing heard',\n    badResponse: 'The transcription response could not be read.',\n    badResponseShort: 'Bad response',\n    paneChanged: 'The input box changed, so nothing was inserted. Transcript: {text}',\n    paneChangedShort: 'Input changed'\n  }\n};\n\nfunction message(lang, key, params = {}) {\n  const table = STRINGS[String(lang || '').toLowerCase().startsWith('ko') ? 'ko' : 'en'];\n  return String(table[key] ?? STRINGS.en[key] ?? key).replace(/\\{(\\w+)\\}/g, (m, k) => (k in params ? String(params[k]) : m));\n}\n\n\t// A key the server refused stays refused until the stored key changes: CLIProxyAPI bans an IP for 30 minutes\n\t// after five rejected management requests, so a wrong key is never retried.\n\tlet rejectedKey = \"\";\n</script>\n\n<script>\n\t// Microphone button for the composer toolbar. Click: record. Click again: stop, upload to the CLIProxyAPI\n\t// mistral-support route (Mistral Voxtral) and append the transcript to the draft. It never sends the message.\n\timport { onDestroy } from \"svelte\";\n\timport { ext, app, getPane } from \"pipaya\";\n\n\tconst pane = getPane();\n\tconst lang = $derived(ext.language);\n\tconst tr = (key, params) => message(lang, key, params);\n\n\tlet phase = $state(\"idle\"); // idle | starting | recording | transcribing\n\tlet elapsed = $state(0);\n\tlet notice = $state(null); // { text, short }\n\tlet root = $state();\n\n\tlet stream = null;\n\tlet recorder = null;\n\tlet chunks = [];\n\tlet mime = \"\";\n\tlet intent = \"send\"; // what to do when the recorder stops: send | cancel\n\tlet startedAt = 0;\n\tlet tick;\n\tlet hardStop;\n\tlet noticeTimer;\n\tlet upload = null;\n\tlet token = 0;\n\tlet gone = false;\n\n\tconst busy = $derived(phase === \"starting\" || phase === \"transcribing\");\n\n\tfunction say(key, params) {\n\t\tclearTimeout(noticeTimer);\n\t\tconst text = tr(key, params);\n\t\tnotice = { text, short: tr(`${key}Short`) };\n\t\tapp.toast(text, \"error\");\n\t\tnoticeTimer = setTimeout(() => { notice = null; }, 9000);\n\t}\n\tfunction clearNotice() { clearTimeout(noticeTimer); notice = null; }\n\n\tfunction release() {\n\t\tclearInterval(tick);\n\t\tclearTimeout(hardStop);\n\t\tif (stream) for (const track of stream.getTracks()) { track.onended = null; try { track.stop(); } catch { /* already stopped */ } }\n\t\tstream = null;\n\t}\n\n\tfunction reset() {\n\t\trelease();\n\t\trecorder = null;\n\t\tchunks = [];\n\t\tphase = \"idle\";\n\t}\n\n\tasync function begin() {\n\t\tclearNotice();\n\t\tconst settings = ext.settings ?? {};\n\t\tif (!originOf(settings.apiBase)) {\n\t\t\tsay(\"needBase\");\n\t\t\tapp.openSettings?.(\"extensions\");\n\t\t\treturn;\n\t\t}\n\t\tconst key = String(settings.apiKey ?? \"\").trim();\n\t\tif (!key) {\n\t\t\tsay(\"needKey\");\n\t\t\tapp.openSettings?.(\"extensions\");\n\t\t\treturn;\n\t\t}\n\t\tif (key === rejectedKey) return say(\"badKey\", { status: 401 });\n\t\tif (!window.isSecureContext) return say(\"insecure\");\n\t\tif (!navigator.mediaDevices?.getUserMedia || typeof MediaRecorder === \"undefined\") return say(\"unsupported\");\n\n\t\tconst mine = ++token;\n\t\tphase = \"starting\";\n\t\tlet media;\n\t\ttry {\n\t\t\tmedia = await navigator.mediaDevices.getUserMedia({ audio: { echoCancellation: true, noiseSuppression: true, autoGainControl: true } });\n\t\t} catch (error) {\n\t\t\tif (mine === token && !gone) { phase = \"idle\"; say(micErrorKind(error)); }\n\t\t\treturn;\n\t\t}\n\t\t// Unmounted or cancelled while the permission prompt was open: close the stream at once.\n\t\tif (gone || mine !== token) { for (const track of media.getTracks()) track.stop(); return; }\n\t\tstream = media;\n\t\ttry {\n\t\t\tmime = pickMimeType((type) => MediaRecorder.isTypeSupported(type));\n\t\t\trecorder = new MediaRecorder(media, mime ? { mimeType: mime } : undefined);\n\t\t} catch {\n\t\t\treset();\n\t\t\treturn say(\"unsupported\");\n\t\t}\n\t\tconst rec = recorder;\n\t\tchunks = [];\n\t\tintent = \"send\";\n\t\trec.ondataavailable = (event) => { if (event.data?.size) chunks.push(event.data); };\n\t\trec.onerror = () => { intent = \"cancel\"; reset(); say(\"micFailed\"); };\n\t\trec.onstop = () => void finish(rec, mine);\n\t\t// The microphone was unplugged or revoked: finish with what was captured.\n\t\tfor (const track of media.getAudioTracks()) track.onended = () => stop();\n\t\trec.start(1000);\n\t\tstartedAt = performance.now();\n\t\telapsed = 0;\n\t\tphase = \"recording\";\n\t\ttick = setInterval(() => { elapsed = performance.now() - startedAt; }, 250);\n\t\thardStop = setTimeout(stop, MAX_RECORD_MS);\n\t}\n\n\tfunction stop(next = \"send\") {\n\t\tif (phase !== \"recording\" || !recorder) return;\n\t\tintent = next;\n\t\telapsed = performance.now() - startedAt;\n\t\tif (recorder.state !== \"inactive\") { try { recorder.stop(); } catch { /* handled by onstop/onerror */ } }\n\t}\n\n\tasync function finish(rec, mine) {\n\t\tconst length = performance.now() - startedAt;\n\t\tconst blob = new Blob(chunks, { type: rec.mimeType || mime || \"audio/webm\" });\n\t\tconst wanted = intent;\n\t\treset(); // the microphone is closed before the upload starts\n\t\tif (gone || mine !== token || wanted === \"cancel\") return;\n\t\tif (length < MIN_RECORD_MS || blob.size < MIN_BLOB_BYTES) return say(\"tooShort\");\n\t\tawait send(blob);\n\t}\n\n\tasync function send(blob) {\n\t\tconst settings = ext.settings ?? {};\n\t\tconst key = String(settings.apiKey ?? \"\").trim();\n\t\tconst base = String(settings.apiBase ?? \"\").trim();\n\t\tconst paneId = pane.id;\n\t\tphase = \"transcribing\";\n\t\tupload = new AbortController();\n\t\ttry {\n\t\t\tconst text = await transcribe({\n\t\t\t\tfetchImpl: (url, init) => fetch(url, init),\n\t\t\t\tapiBase: base,\n\t\t\t\tapiKey: key,\n\t\t\t\tmodel: settings.model,\n\t\t\t\tlanguage: settings.language,\n\t\t\t\tblob,\n\t\t\t\tsignal: upload.signal\n\t\t\t});\n\t\t\tif (gone) return;\n\t\t\tphase = \"idle\";\n\t\t\tinsert(text, paneId);\n\t\t} catch (error) {\n\t\t\tif (gone) return;\n\t\t\tphase = \"idle\";\n\t\t\tconst kind = error?.kind ?? \"network\";\n\t\t\tif (kind === \"aborted\") return;\n\t\t\tif (kind === \"badKey\") rejectedKey = key;\n\t\t\tif (kind === \"needBase\") app.openSettings?.(\"extensions\");\n\t\t\tsay(kind, { status: error?.status ?? \"\", host: hostOf(base), sec: Math.round(UPLOAD_TIMEOUT_MS / 1000) });\n\t\t} finally {\n\t\t\tupload = null;\n\t\t}\n\t}\n\n\tfunction insert(text, paneId) {\n\t\t// Another chat took the input box meanwhile: do not put the words into the wrong draft.\n\t\tif (pane.id !== paneId) return say(\"paneChanged\", { text });\n\t\tconst box = root?.closest('[data-part=\"composer\"]')?.querySelector(\"textarea[data-composer]\");\n\t\tif (!box) {\n\t\t\tapp.prefill = text; // the app appends it to the draft\n\t\t\treturn;\n\t\t}\n\t\tconst value = joinDraft(box.value, text);\n\t\tObject.getOwnPropertyDescriptor(HTMLTextAreaElement.prototype, \"value\").set.call(box, value);\n\t\tbox.dispatchEvent(new Event(\"input\", { bubbles: true })); // keeps the composer's own state in step\n\t\t// On a phone, focusing would pop the keyboard up over the result.\n\t\tif (!matchMedia(\"(pointer: coarse)\").matches) box.focus({ preventScroll: true });\n\t\ttry { box.setSelectionRange(value.length, value.length); } catch { /* not focusable */ }\n\t}\n\n\tfunction onclick() {\n\t\tif (phase === \"recording\") stop();\n\t\telse if (phase === \"idle\") void begin();\n\t}\n\n\tonDestroy(() => {\n\t\tgone = true;\n\t\ttoken++;\n\t\tclearTimeout(noticeTimer);\n\t\tintent = \"cancel\";\n\t\tif (recorder && recorder.state !== \"inactive\") { try { recorder.stop(); } catch { /* closing anyway */ } }\n\t\tupload?.abort();\n\t\trelease();\n\t});\n\n\tconst label = $derived(phase === \"recording\" ? tr(\"recording\") : phase === \"transcribing\" ? tr(\"transcribing\") : tr(\"idle\"));\n</script>\n\n<div class=\"vi\" bind:this={root} data-state={phase}>\n\t<button\n\t\ttype=\"button\"\n\t\tclass=\"iconbtn mic\"\n\t\tclass:rec={phase === \"recording\"}\n\t\tclass:err={!!notice && phase === \"idle\"}\n\t\taria-label={label}\n\t\taria-pressed={phase === \"recording\"}\n\t\ttitle={label}\n\t\tdisabled={busy}\n\t\t{onclick}\n\t>\n\t\t{#if phase === \"recording\"}\n\t\t\t<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><rect class=\"solid\" x=\"7\" y=\"7\" width=\"10\" height=\"10\" rx=\"2\" /></svg>\n\t\t{:else if busy}\n\t\t\t<svg class=\"spin\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 3a9 9 0 1 0 9 9\" /></svg>\n\t\t{