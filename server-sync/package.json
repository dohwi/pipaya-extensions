{
  "name": "pipaya-extension-server-sync",
  "version": "0.8.0",
  "description": "Mirrors a primary pipaya server's settings onto this one: model connections, defaults, MCP servers, skills, tools.",
  "license": "MIT",
  "author": "dohwi",
  "pipaya": {
    "title": "Server Sync",
    "descriptions": {
      "en": "Mirrors a primary pipaya server's settings onto this one: model connections, defaults, MCP servers, skills, tools. The primary shows its address and token to copy; a follower needs only the address.",
      "ko": "기준 서버의 설정(모델 연결, 기본값, MCP 서버, 스킬, 도구)을 이 서버로 그대로 복제합니다. 기준 서버는 자기 주소와 토큰을 화면에 보여주고, 팔로워는 주소만 넣으면 연결됩니다."
    },
    "settings": [
      {
        "key": "statusText",
        "type": "string",
        "label": "상태",
        "description": "자동으로 갱신됩니다.",
        "default": "",
        "readonly": true
      },
      {
        "key": "role",
        "type": "select",
        "label": "역할",
        "description": "기준: 이 서버의 설정을 다른 서버에 건네줍니다. 팔로워: 기준 서버에서 아래에 체크한 항목만 받아옵니다.",
        "default": "primary",
        "options": [
          {
            "value": "primary",
            "label": "기준 (설정을 건네줌)"
          },
          {
            "value": "follower",
            "label": "팔로워 (설정을 받아옴)"
          }
        ]
      },
      {
        "key": "remoteUrl",
        "type": "string",
        "label": "상대 서버 주소",
        "description": "기준 서버 주소. 아래에 연결 링크를 붙여넣으면 비워 둬도 됩니다.",
        "default": "",
        "placeholder": "http://100.x.x.x:8787",
        "when": {
          "key": "role",
          "equals": "follower"
        }
      },
      {
        "key": "shareCode",
        "type": "string",
        "label": "연결 코드 또는 링크",
        "description": "기준 서버의 기기 탭 → 폰 추가 → [링크 복사]로 받은 값을 붙여넣으세요. 2분간 유효, 1회용.",
        "default": "",
        "when": {
          "key": "role",
          "equals": "follower"
        }
      },
      {
        "key": "syncModels",
        "type": "boolean",
        "label": "모델 (기본·시스템·이미지 모델)",
        "default": true,
        "when": {
          "key": "role",
          "equals": "follower"
        }
      },
      {
        "key": "syncWorkdir",
        "type": "boolean",
        "label": "기본 작업 디렉터리",
        "default": true,
        "when": {
          "key": "role",
          "equals": "follower"
        },
        "description": "두 서버의 폴더 구조가 다르면 끄세요."
      },
      {
        "key": "syncMcp",
        "type": "boolean",
        "label": "MCP 서버",
        "default": true,
        "when": {
          "key": "role",
          "equals": "follower"
        }
      },
      {
        "key": "syncSkills",
        "type": "boolean",
        "label": "스킬 켜기·끄기",
        "default": true,
        "when": {
          "key": "role",
          "equals": "follower"
        }
      },
      {
        "key": "syncTools",
        "type": "boolean",
        "label": "도구·도우미 설정",
        "default": true,
        "when": {
          "key": "role",
          "equals": "follower"
        },
        "description": "꺼 둔 도구와 도우미, 위임 정책."
      },
      {
        "key": "syncHistory",
        "type": "boolean",
        "label": "대화 압축·보관 기간",
        "default": true,
        "when": {
          "key": "role",
          "equals": "follower"
        }
      },
      {
        "key": "syncExtensions",
        "type": "boolean",
        "label": "확장 설정",
        "default": false,
        "when": {
          "key": "role",
          "equals": "follower"
        },
        "description": "설치된 확장들의 설정값. 토큰·비밀번호 같은 값은 가져오지 않고 이 서버 것을 그대로 둡니다."
      }
    ]
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/dohwi/pipaya-extensions.git",
    "directory": "server-sync"
  },
  "scripts": {
    "test": "bun test"
  }
}
