{
  "id": "quota-monitor",
  "name": "Quota Monitor",
  "version": "0.9.2",
  "sdkVersion": 1,
  "description": "Claude · GPT · Antigravity의 5시간·주간 잔량과 계정 수를 2줄 미니 막대 타일과 팝오버로 표시합니다(데스크톱 상단 바, 모바일 사이드바 상단). Antigravity는 좌측 Gemini · 우측 Claude/GPT 잔량입니다.",
  "permissions": [
    "ui-components",
    "http-write",
    "events",
    "context"
  ],
  "settings": [
    {
      "key": "httpOrigin",
      "type": "string",
      "label": "CLIProxyAPI 주소",
      "description": "경로·계정 없이 origin만 입력",
      "placeholder": "http://localhost:8317",
      "required": true,
      "format": "origin"
    },
    {
      "key": "httpToken",
      "type": "string",
      "label": "관리 키",
      "description": "서버에 저장·공유되며 설정 내보내기에서는 제외됩니다.",
      "required": true,
      "secret": true
    },
    {
      "key": "language",
      "type": "select",
      "label": "언어",
      "description": "자동은 pipaya 앱 언어를 따릅니다.",
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": "자동 (앱 언어)"
        },
        {
          "value": "ko",
          "label": "한국어"
        },
        {
          "value": "en",
          "label": "English"
        }
      ]
    },
    {
      "key": "pollSeconds",
      "type": "number",
      "label": "갱신 주기(초)",
      "description": "비우면 서버 기본 간격 사용",
      "min": 10,
      "max": 900
    }
  ],
  "settingsScope": "server"
}
